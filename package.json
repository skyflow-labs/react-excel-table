{
  "name": "react-excel-table",
  "version": "1.2.1",
  "description": "Excel-like editable data table for React with virtualization, keyboard navigation, and Excel import/export",
  "license": "MIT",
  "author": "SkyflowLabs",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./plugins/excel-import": {
      "import": {
        "types": "./dist/plugins/excel-import/index.d.ts",
        "default": "./dist/plugins/excel-import/index.js"
      },
      "require": {
        "types": "./dist/plugins/excel-import/index.d.cts",
        "default": "./dist/plugins/excel-import/index.cjs"
      }
    },
    "./plugins/excel-export": {
      "import": {
        "types": "./dist/plugins/excel-export/index.d.ts",
        "default": "./dist/plugins/excel-export/index.js"
      },
      "require": {
        "types": "./dist/plugins/excel-export/index.d.cts",
        "default": "./dist/plugins/excel-export/index.cjs"
      }
    },
    "./styles": "./dist/styles/index.css"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.build.json && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:ui": "vitest --ui",
    "lint": "eslint src --ext .ts,.tsx",
    "lint:fix": "eslint src --ext .ts,.tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "typecheck": "tsc --noEmit",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@tanstack/react-table": "^8.20.0",
    "date-fns": "^3.6.0",
    "date-fns-tz": "^3.1.3",
    "react-window": "^1.8.10",
    "react-virtualized-auto-sizer": "^1.0.24"
  },
  "peerDependencies": {
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "optionalDependencies": {
    "papaparse": "^5.4.0",
    "exceljs": "^4.4.0"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "^8.0.0",
    "@storybook/addon-interactions": "^8.0.0",
    "@storybook/addon-links": "^8.0.0",
    "@storybook/blocks": "^8.0.0",
    "@storybook/react": "^8.0.0",
    "@storybook/react-vite": "^8.0.0",
    "@storybook/test": "^8.0.0",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^15.0.0",
    "@testing-library/user-event": "^14.5.0",
    "@types/node": "^20.11.0",
    "@types/papaparse": "^5.3.14",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@types/react-window": "^1.8.8",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "@vitejs/plugin-react": "^4.2.0",
    "@vitest/coverage-v8": "^1.2.0",
    "@vitest/ui": "^1.2.0",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.33.0",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-storybook": "^0.8.0",
    "jsdom": "^24.0.0",
    "prettier": "^3.2.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "storybook": "^8.0.0",
    "typescript": "^5.3.0",
    "vite": "^5.0.0",
    "vite-plugin-dts": "^4.5.4",
    "vitest": "^1.2.0"
  },
  "keywords": [
    "react",
    "excel",
    "table",
    "editable",
    "spreadsheet",
    "data-grid",
    "virtualization",
    "keyboard-navigation",
    "import",
    "export"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/skyflow-labs/react-excel-table.git"
  },
  "bugs": {
    "url": "https://github.com/skyflow-labs/react-excel-table/issues"
  },
  "homepage": "https://github.com/skyflow-labs/react-excel-table#readme"
}
